{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    [
      "./plugins/omniroute/dist/index.js",
      {
        "providerId": "omniroute",
        "baseURL": "http://192.168.0.201:20128",
        "autoSyncIntervalMs": 0
      }
    ]
  ,
    "@openviking/opencode-plugin",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-chrome-devtools@1.0.4"
  ],
  "lsp": true,
  "default_agent": "build",
  "model": "opencode-omniroute/opencode/deepseek-v4-flash",
  "autoupdate": false,

  "mcp": {
{{ if ne .chezmoi.hostname "hermes" }}    "openviking": {
      "type": "local",
      "command": [
        "node",
        "{{ .chezmoi.homeDir }}/.openviking/opencode-mcp-proxy/openviking/servers/mcp-proxy.mjs"
      ],
      "enabled": true,
      "timeout": 15000
    },
{{ end }}{{ if ne .chezmoi.hostname "hermes" }}    "n8n": {
      "type": "remote",
      "url": "https://n8n.papatenko.org/mcp-server/http",
      "enabled": true
    },
    "obsidian-vault": {
      "type": "local",
      "command": ["uvx", "mcp-obsidian"],
      "environment": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      },
      "enabled": true
    },
{{ end }}    "notebooklm": {
      "type": "local",
      "command": ["npx", "-y", "notebooklm-mcp@latest"],
      "enabled": true,
      "timeout": 900000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
{{ if and (ne .chezmoi.os "windows") (ne .chezmoi.hostname "hermes") }}    "browser-harness": {
      "type": "local",
      "command": ["browser-harness-mcp"],
      "environment": { "BU_NAME": "brave" },
      "enabled": true
    },
{{ end }}{{ if ne .chezmoi.hostname "hermes" }}    "omniroute-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:18201/api/mcp/stream",
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MCP_API_KEY}"
      },
      "oauth": false
    },
{{ end }}    "coolify": {
      "type": "local",
      "command": ["npx", "-y", "@masonator/coolify-mcp@latest"],
      "enabled": true,
      "env": {
        "COOLIFY_API_TOKEN": "<YOUR_COOLIFY_TOKEN>",
        "COOLIFY_API_URL": "https://<YOUR_COOLIFY_URL>"
      }
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    },
    "pressable": {
      "type": "remote",
      "url": "https://mcp.pressable.com/mcp",
      "enabled": true
    },
    "webui": {
      "type": "local",
      "command": ["{{ .chezmoi.homeDir }}/.local/bin/course-rag-mcp"],
      "enabled": true,
      "timeout": 300000
    },
    "hister": {
      "type": "remote",
      "url": "http://192.168.0.200:4433/mcp",
      "enabled": true
    },
{{ if and (ne .chezmoi.os "windows") (ne .chezmoi.hostname "hermes") }}    "google-workspace-personal": {
      "type": "local",
      "command": ["uvx", "workspace-mcp", "--single-user", "--tools", "gmail", "drive", "calendar", "docs", "sheets", "slides"],
      "environment": {
        "GOOGLE_CLIENT_SECRET_PATH": "{{ .chezmoi.homeDir }}/.config/google-workspace-mcp/client_secret.json",
        "WORKSPACE_MCP_CREDENTIALS_DIR": "{{ .chezmoi.homeDir }}/.config/google-workspace-mcp/personal",
        "USER_GOOGLE_EMAIL": "jkcondor13@gmail.com"
      },
      "enabled": true
    },
    "google-workspace-work": {
      "type": "local",
      "command": ["uvx", "workspace-mcp", "--single-user", "--tools", "gmail", "drive", "calendar", "docs", "sheets", "slides"],
      "environment": {
        "GOOGLE_CLIENT_SECRET_PATH": "{{ .chezmoi.homeDir }}/.config/google-workspace-mcp/client_secret.json",
        "WORKSPACE_MCP_CREDENTIALS_DIR": "{{ .chezmoi.homeDir }}/.config/google-workspace-mcp/work",
        "USER_GOOGLE_EMAIL": "justin@momentafire.com"
      },
      "enabled": true
    }
{{ end }}  },
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/opencode/global-instructions.md"
  ]
}
