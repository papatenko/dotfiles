{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    [
      "./plugins/omniroute/dist/index.js",
      {
        "providerId": "omniroute",
        "baseURL": "http://192.168.0.201:20128",
        "autoSyncIntervalMs": 0
      }
    ]
  ,
    "@openviking/opencode-plugin",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-chrome-devtools@1.0.4",
{{ if ne .chezmoi.hostname "hermes" }}    "oh-my-openagent",
{{ end }}    "@tarquinen/opencode-dcp@latest"
  ],
  "lsp": true,
  "default_agent": "build",
  "model": "opencode-omniroute/opencode/deepseek-v4-flash",
  "autoupdate": false,

  "mcp": {
{{ if ne .chezmoi.hostname "hermes" }}    "openviking": {
      "type": "local",
      "command": [
        "node",
        "{{ .chezmoi.homeDir }}/.openviking/opencode-mcp-proxy/openviking/servers/mcp-proxy.mjs"
      ],
      "enabled": true,
      "timeout": 15000
    },
{{ end }}    "notebooklm": {
      "type": "local",
      "command": ["npx", "-y", "notebooklm-mcp@latest"],
      "enabled": true,
      "timeout": 900000
    },
{{ if ne .chezmoi.hostname "hermes" }}    "browseros-neo": {
      "type": "remote",
      "url": "http://127.0.0.1:9011/mcp",
      "oauth": false,
      "codemode": false
    },
{{ end }}    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
{{ if and (ne .chezmoi.os "windows") (ne .chezmoi.hostname "hermes") }}    "browser-harness": {
      "type": "local",
      "command": ["browser-harness-mcp"],
      "enabled": true
    },
{{ end }}{{ if ne .chezmoi.hostname "hermes" }}    "omniroute-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:18201/api/mcp/stream",
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MCP_API_KEY}"
      },
      "oauth": false
    },
{{ end }}    "coolify": {
      "type": "local",
      "command": ["npx", "-y", "@masonator/coolify-mcp@latest"],
      "enabled": true,
      "env": {
        "COOLIFY_API_TOKEN": "<YOUR_COOLIFY_TOKEN>",
        "COOLIFY_API_URL": "https://<YOUR_COOLIFY_URL>"
      }
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    }
  },
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/opencode/global-instructions.md"
  ]
}
