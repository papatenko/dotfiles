{
{{ if ne .chezmoi.hostname "DESKTOP-17L7TR0" }}  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
{{ end }}  "permissions": {
    "defaultMode": "plan",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/{{ if eq .chezmoi.os "windows" }}Nextcloud2{{ else }}Nextcloud{{ end }}/Apps/Obsidian"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": {{ if eq .chezmoi.os "windows" }}"pwsh -NoProfile -ExecutionPolicy Bypass -File '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.ps1' session"{{ else }}"bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session"{{ end }},
            "timeout": 10
          }
        ]
      }{{ if ne .chezmoi.hostname "DESKTOP-17L7TR0" }},
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }{{ end }}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ if eq .chezmoi.os "windows" }}"pwsh -NoProfile -ExecutionPolicy Bypass -Command \"node '{{ .chezmoi.homeDir }}/.tokentracker/bin/notify.cjs' --source=claude\""{{ else }}"/usr/bin/env node {{ .chezmoi.homeDir }}/.tokentracker/bin/notify.cjs --source=claude"{{ end }}
          }
        ]
      }{{ if ne .chezmoi.hostname "DESKTOP-17L7TR0" }},
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }{{ end }}
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ if eq .chezmoi.os "windows" }}"pwsh -NoProfile -ExecutionPolicy Bypass -Command \"node '{{ .chezmoi.homeDir }}/.tokentracker/bin/notify.cjs' --source=claude\""{{ else }}"/usr/bin/env node {{ .chezmoi.homeDir }}/.tokentracker/bin/notify.cjs --source=claude"{{ end }}
          }
        ]
      }{{ if ne .chezmoi.hostname "DESKTOP-17L7TR0" }},
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }{{ end }}
    ]{{ if ne .chezmoi.hostname "DESKTOP-17L7TR0" }},
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.local/bin/caveman' shrink-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.caveman/bin/caveman-proxy' native-hook claude --adapter '{{ .chezmoi.homeDir }}/.local/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'"
          }
        ]
      }
    ]{{ end }}
  },
  "enabledPlugins": {
    "composio@composio": true,
    "warp@claude-code-warp": true,
    "openviking-memory@openviking": true
  },
  "extraKnownMarketplaces": {
    "composio": {
      "source": {
        "source": "git",
        "url": "https://github.com/ComposioHQ/composio-plugin-cc.git"
      }
    },
    "openviking": {
      "source": {
        "source": "url",
        "url": "https://raw.githubusercontent.com/volcengine/OpenViking/main/.claude-plugin/marketplace.json"
      }
    }
  },
  "effortLevel": "{{ if eq .chezmoi.hostname "DESKTOP-17L7TR0" }}low{{ else }}high{{ end }}",
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
{{ if eq .chezmoi.hostname "DESKTOP-17L7TR0" }}
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
