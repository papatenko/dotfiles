{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
set -eu

# browser-harness 0.1.x: CLI + MCP server (browser-harness-mcp). Bump to reinstall.
uv tool install --python 3.12 --upgrade --force 'browser-harness[mcp]'
browser-harness recordings disable
browser-harness telemetry disable
{{ if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
# WSL: relay CDP to Windows Brave (NAT networking hides its 127.0.0.1 port).
# Relay follows Brave's DevToolsActivePort port (2026-10-19).
systemctl --user daemon-reload
systemctl --user enable browser-harness-cdp-relay.service
systemctl --user restart browser-harness-cdp-relay.service
{{ end }}{{ end -}}
