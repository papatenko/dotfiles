#!/usr/bin/env python3
import json
import sys

current_text = sys.stdin.read()
try:
    current = json.loads(current_text) if current_text.strip() else {}
except json.JSONDecodeError:
    sys.stdout.write(current_text)
    sys.exit(0)

desired_notebooklm = {"command": "npx", "args": ["-y", "notebooklm-mcp@latest"]}
servers = current.get("mcpServers")
if not isinstance(servers, dict):
    servers = {}
if (servers.get("notebooklm") == desired_notebooklm and
        not any(name in servers for name in ("browseros", "browseros-neo")) and
        isinstance(current.get("mcpServers"), dict)):
    sys.stdout.write(current_text)
    sys.exit(0)
servers.pop("browseros", None)
servers.pop("browseros-neo", None)
servers["notebooklm"] = desired_notebooklm
current["mcpServers"] = servers
sys.stdout.write(json.dumps(current, indent=2, ensure_ascii=False) + "\n")
