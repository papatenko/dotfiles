#!/usr/bin/env python3
import json
import os
import re
import sys

current_text = sys.stdin.read()
try:
    current = json.loads(current_text) if current_text.strip() else {}
except json.JSONDecodeError:
    sys.stdout.write(current_text)
    sys.exit(0)

home = os.path.expanduser("~")

def portable_home(value):
    if isinstance(value, str):
        value = re.sub(r"'" + re.escape(home) + r"([^']*)'", r'"$HOME\1"', value)
        return value.replace(home, "$HOME")
    if isinstance(value, list):
        return [portable_home(item) for item in value]
    if isinstance(value, dict):
        return {key: portable_home(item) for key, item in value.items()}
    return value

current = portable_home(current)

servers = current.get("mcpServers")
if isinstance(servers, dict):
    for name in ("browseros", "browseros-neo", "caveman"):
        servers.pop(name, None)
else:
    servers = {}
{{ if ne .chezmoi.os "windows" }}servers.setdefault("browser-harness", {"type": "stdio", "command": "browser-harness-mcp", "args": []})
{{ end }}current["mcpServers"] = servers
sys.stdout.write(json.dumps(current, indent=2, ensure_ascii=False) + "\n")
