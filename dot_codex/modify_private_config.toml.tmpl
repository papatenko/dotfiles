#!/usr/bin/env python3
# Managed by chezmoi (dot_codex/modify_config.toml.tmpl).
# Ensures the OpenViking + Composio plugin/marketplace registrations and
# Playwright MCP registration are
# present in ~/.codex/config.toml
# without touching projects (per-machine trust levels),
# or any other existing content in the file.
import re
import sys

try:
    import tomllib
except ImportError:
    import tomli as tomllib

current_text = sys.stdin.read()
try:
    current = tomllib.loads(current_text) if current_text.strip() else {}
except tomllib.TOMLDecodeError:
    sys.stderr.write("modify_config.toml.tmpl: existing config.toml is not valid TOML, leaving untouched\n")
    sys.stdout.write(current_text)
    sys.exit(0)

plugins = current.get("plugins", {})
marketplaces = current.get("marketplaces", {})
blocks = []

if not plugins.get("openviking-memory@openviking", {}).get("enabled"):
    blocks.append(
        '[plugins."openviking-memory@openviking"]\n'
        "enabled = true\n"
    )

if not plugins.get("composio@composio", {}).get("enabled"):
    blocks.append(
        '[plugins."composio@composio"]\n'
        "enabled = true\n"
    )

if "openviking" not in marketplaces:
    blocks.append(
        "[marketplaces.openviking]\n"
        'source_type = "git"\n'
        f'source = "https://github.com/volcengine/OpenViking.git"\n'
        'ref = "main"\n'
        'sparse_paths = ["examples/codex-memory-plugin", ".agents"]\n'
    )

if "composio" not in marketplaces:
    blocks.append(
        "[marketplaces.composio]\n"
        'source_type = "git"\n'
        'source = "https://github.com/ComposioHQ/composio-plugin-openai.git"\n'
    )

if "playwright" not in current.get("mcp_servers", {}):
    blocks.append(
        "[mcp_servers.playwright]\n"
        'command = "npx"\n'
        'args = ["-y", "@playwright/mcp@latest"]\n'
    )
{{ if ne .chezmoi.os "windows" }}
if "browser-harness" not in current.get("mcp_servers", {}):
    blocks.append(
        "[mcp_servers.browser-harness]\n"
        'command = "browser-harness-mcp"\n'
    )
{{ end }}
output = current_text

# Caveman owns only these delimited blocks and the legacy standalone tables.
# Normalize them so `caveman doctor codex` can safely maintain its native route.
for begin, end in [
    ("# >>> caveman:native-tables", "# <<< caveman:native-tables"),
]:
    output = re.sub(
        rf"(?ms)^{re.escape(begin)}\n.*?^{re.escape(end)}\n?",
        "",
        output,
    )

for table in ["model_providers.caveman", "mcp_servers.caveman"]:
    output = re.sub(
        rf"(?ms)^\[{re.escape(table)}\]\n.*?(?=^\[|^# ---|^# >>>|\Z)",
        "",
        output,
    )

output = re.sub(
    r"(?ms)^# --- Headroom MCP server ---\n\[mcp_servers\.headroom\]\n.*?^# --- end Headroom MCP server ---\n?",
    "",
    output,
)
output = output.replace("# --- Headroom MCP server: serena ---", "# --- Serena MCP server ---")
output = output.replace("# --- end Headroom MCP server: serena ---", "# --- end Serena MCP server ---")

caveman_tables = (
    "# >>> caveman:native-tables\n"
    "[model_providers.caveman]\n"
    'name = "Caveman"\n'
    'base_url = "http://127.0.0.1:8787/chatgpt"\n'
    'wire_api = "responses"\n'
    "requires_openai_auth = true\n\n"
    "[mcp_servers.caveman]\n"
    'command = "{{ .chezmoi.homeDir }}/.caveman/bin/caveman-mcp"\n'
    "# <<< caveman:native-tables\n"
)
output = output.rstrip() + "\n\n" + caveman_tables
if blocks:
    if output and not output.endswith("\n"):
        output += "\n"
    if output:
        output += "\n"
    output += "\n".join(blocks)

sys.stdout.write(output)
