#!/usr/bin/env bash
# Recolor Papirus-Dark folders to nearest Papirus color of current Plasma accent.
rgb=$(kreadconfig6 --file kdeglobals --group General --key AccentColor)
[ -z "$rgb" ] && exit 0
python3 - "$rgb" <<'PY' | xargs -r -I{} papirus-folders -t Papirus-Dark -C {} -o -u
import sys, colorsys
r, g, b = (int(x) / 255 for x in sys.argv[1].split(","))
h, s, v = colorsys.rgb_to_hsv(r, g, b)
if s < 0.18:
    print("grey" if v > 0.25 else "black"); sys.exit()
h *= 360
for upto, name in [(15,"red"),(35,"deeporange"),(48,"orange"),(70,"yellow"),(150,"green"),
                   (170,"teal"),(195,"cyan"),(250,"blue"),(275,"indigo"),(295,"violet"),
                   (330,"magenta"),(345,"pink"),(361,"red")]:
    if h < upto:
        print(name); break
PY
